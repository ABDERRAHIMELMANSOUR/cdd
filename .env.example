# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Project: hjgichoicmkepvmluosh
#
# TWO urls are required. Both are REQUIRED even locally: `prisma generate`
# refuses to run when DIRECT_URL is missing, and `npm run build` calls it.
#
#   DATABASE_URL  the running app        transaction pooler, port 6543
#   DIRECT_URL    db push / migrations   session pooler,     port 5432
#
# Copy both from the Supabase dashboard:
#   Project Settings → Database → Connection string → "Connection pooling"
# and pick the two modes from the dropdown. Use the host the dashboard shows —
# the region is part of it (aws-0-<region>.pooler.supabase.com) and guessing it
# gives a hostname that does not resolve.
#
# Note the username shape: it is `postgres.<project-ref>`, not plain `postgres`.
# The pooler uses it to route to the right project, and a plain `postgres`
# username fails to authenticate against a password that is otherwise correct.
#
# `pgbouncer=true` is not optional on 6543: it tells Prisma to stop using
# prepared statements. Without it the app fails under concurrency with
# "prepared statement s0 already exists" — intermittently, only in production.
#
# `connection_limit=1` keeps each serverless instance to a single connection,
# which is the point of using a pooler at all.

DATABASE_URL="postgresql://postgres.hjgichoicmkepvmluosh:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.hjgichoicmkepvmluosh:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# A password with @ : / ? # & in it MUST be percent-encoded, or the URL parses
# as a different host and the error blames the host rather than the password.
#   @ → %40    : → %3A    / → %2F    ? → %3F    # → %23    & → %26

# ─── Auth (NextAuth / Auth.js) ───────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-please-generate-a-long-random-string"
# The exact public origin, with https:// and no trailing slash.
NEXTAUTH_URL="http://localhost:3000"

# ─── Initial admin (used by `npm run seed`) ──────────────────────────────────
ADMIN_EMAIL="admin@cddpaysbas.nl"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Super Admin"

# ─── Demo supporter (optional, never in production) ──────────────────────────
# Creates a MEMBER account so the portal can be clicked through before real
# sign-ups exist. The seed ignores it when NODE_ENV=production.
# MEMBER_DEMO_PASSWORD=""
