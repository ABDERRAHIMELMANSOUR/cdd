# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (production / Supabase). Example:
#   postgresql://USER:PASSWORD@HOST:5432/cdd?schema=public
# For Supabase use the "Connection string" (session pooler) from your project.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cdd?schema=public"

# ─── Auth (NextAuth / Auth.js) ───────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-please-generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── Initial admin (used by `npm run seed`) ──────────────────────────────────
ADMIN_EMAIL="admin@cddpaysbas.nl"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Super Admin"
