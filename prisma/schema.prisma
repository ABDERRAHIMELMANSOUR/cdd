// CDD Pays-Bas — Prisma schema
// Provider: PostgreSQL (works with Supabase). All website content is stored here
// so it can be managed entirely from the Admin Dashboard without editing code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // ── TWO URLS, ON PURPOSE (Supabase + serverless) ───────────────────────────
  // DATABASE_URL is what the running app uses. On Vercel every request can be
  // a fresh lambda, and each one opening its own PostgreSQL connection
  // exhausts the server's limit long before traffic justifies it — so this
  // points at Supabase's TRANSACTION pooler (port 6543) with `pgbouncer=true`,
  // which tells Prisma to stop using prepared statements. Without that flag
  // the transaction pooler fails at runtime with "prepared statement already
  // exists", intermittently, under concurrency — the worst way to find out.
  //
  // DIRECT_URL is used only by `prisma db push` and `prisma migrate`. Schema
  // changes need a real session, which a transaction pooler cannot give them,
  // so this points at the SESSION pooler (port 5432).
  //
  // Both go through the pooler host rather than db.<ref>.supabase.co: that
  // direct host now resolves to IPv6 only, and Vercel's build and lambda
  // network reaches it unreliably. The pooler answers on IPv4.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Authentication & roles ──────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  // Supporters of the stichting. They reach the community portal at /portal and
  // never the CMS at /admin. Added last so every existing row keeps its role.
  MEMBER
}

/// Where a supporter sits in the approval flow. A registration arrives PENDING
/// and stays invisible in the directory until the board approves it — the
/// portal is a private network, so appearing in it is a decision, not a default.
enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EDITOR)
  image     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Community portal profile ───────────────────────────────────────────────
  // Every field is optional, so existing CMS users stay valid with no backfill.
  // The avatar reuses `image` above rather than adding avatarUrl: NextAuth
  // already carries `image` into the session, and two fields for one face is
  // exactly how they drift apart.
  status      MemberStatus @default(PENDING)
  position    String?
  company     String?
  bio         String?      @db.Text
  linkedinUrl String?
  website     String?
  phone       String?
  /// Commission the supporter associates with, keyed to the public site's
  /// commission slugs. A plain string rather than a relation: the commissions
  /// live in the website's code, not in this database, and a foreign key to a
  /// table that does not own them would be a lie.
  commission  String?
  /// Drives "last active" in the directory. Written on portal page loads.
  lastSeenAt  DateTime?

  // Namespaced Community* because the CMS already owns a `Post` model for the
  // public site's articles. Two unrelated things called Post in one schema is
  // how a query ends up joining a blog article to a supporter's like.
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  communityLikes    CommunityLike[]
  sentMessages      Message[]          @relation("MessagesSent")
  receivedMessages  Message[]          @relation("MessagesReceived")

  @@index([role, status])
}

// ─── Community portal ────────────────────────────────────────────────────────

model CommunityPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  mediaUrl  String?
  /// Set by an admin moderating the feed. A hidden post stays in the table so
  /// the action is auditable rather than silently destructive.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments CommunityComment[]
  likes    CommunityLike[]

  @@index([createdAt])
  @@index([authorId])
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String        @db.Text
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([postId, createdAt])
}

model CommunityLike {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  /// One like per person per post, enforced by the database rather than by
  /// remembering to check in every code path that could create one.
  @@unique([postId, authorId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, read])
}

// ─── SEO (reusable per page / entity) ────────────────────────────────────────

model Seo {
  id        String   @id @default(cuid())
  // key identifies which page/entity this SEO record belongs to (e.g. "home", "about")
  key       String   @unique
  metaTitle String?
  metaDesc  String?
  ogImage   String?
  slug      String?
  updatedAt DateTime @updatedAt
}

// ─── Editable pages (Home, About, ImpactNow, etc.) ───────────────────────────
// Flexible JSON blob lets the dashboard manage hero text, sections, stats, etc.

model Page {
  id        String   @id @default(cuid())
  key       String   @unique // "home" | "about" | "impactnow" | "membership" | "contact"
  title     String
  // content holds structured data (hero, sections, stats, body...) as JSON
  content   Json
  published Boolean  @default(true)
  metaTitle String?
  metaDesc  String?
  ogImage   String?
  updatedAt DateTime @updatedAt
}

// ─── Leadership (President + Board members) ──────────────────────────────────

model Leader {
  id          String   @id @default(cuid())
  name        String
  position    String
  isPresident Boolean  @default(false)
  photo       String?
  bio         String?  @db.Text
  linkedin    String?
  email       String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Advisors (most important section) ───────────────────────────────────────

model Advisor {
  id        String   @id @default(cuid())
  name      String
  position  String
  category  String   @default("Senior Advisor") // expertise / category for filtering
  photo     String?
  shortBio  String?  @db.Text
  longBio   String?  @db.Text
  linkedin  String?
  email     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  banner       String?
  date         DateTime
  time         String?
  location     String?
  description  String?  @db.Text
  registration String? // registration link
  gallery      String[] // image URLs (after-event gallery)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  image     String?
  summary   String?  @db.Text
  content   String?  @db.Text
  status    String   @default("ongoing") // ongoing | completed | upcoming
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Blog / News ─────────────────────────────────────────────────────────────

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostTags")
}

enum PostType {
  BLOG
  NEWS
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String?   @db.Text
  featured    String? // featured image
  type        PostType  @default(BLOG)
  published   Boolean   @default(false) // draft by default
  publishedAt DateTime?
  authorName  String?
  // SEO
  metaTitle   String?
  metaDesc    String?
  ogImage     String?
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  tags        Tag[]     @relation("PostTags")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([published])
}

// ─── Partnerships ────────────────────────────────────────────────────────────

model Partner {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  description String?  @db.Text
  url         String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Networking Packages ─────────────────────────────────────────────────────

model Package {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  price       String? // optional, kept as string for flexibility (e.g. "€ 1.500 / an")
  features    String[] // bullet list of features
  ctaLabel    String?  @default("Nous contacter")
  ctaUrl      String?  @default("/contact")
  featured    Boolean  @default(false)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Media library ───────────────────────────────────────────────────────────

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  type      String // image | pdf | document | logo | other
  mimeType  String?
  size      Int?
  alt       String?
  createdAt DateTime @default(now())
}

// ─── Site-wide settings (logo, contact, social, colors) ──────────────────────

model SiteSettings {
  id          String   @id @default("singleton")
  siteName    String   @default("CDD Pays-Bas")
  logo        String?
  tagline     String?
  email       String?
  phone       String?
  address     String?
  linkedin    String?
  facebook    String?
  instagram   String?
  twitter     String?
  // brand colors (optional override of the CSS theme)
  brandColor  String?
  accentColor String?
  updatedAt   DateTime @updatedAt
}

// ─── Contact / membership submissions ────────────────────────────────────────

model Submission {
  id        String   @id @default(cuid())
  type      String   @default("contact") // contact | membership
  name      String
  email     String
  company   String?
  message   String?  @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
